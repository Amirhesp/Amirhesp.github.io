---
/**
 * Shared section shell: consistent width, vertical rhythm and heading style
 * across the page. Every content section goes through this so spacing is
 * defined in exactly one place.
 */
interface Props {
  id: string;
  title: string;
  /** Renders on a tinted background to separate adjacent sections. */
  tinted?: boolean;
  class?: string;
}

const { id, title, tinted = false, class: className = '' } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-20 px-6 py-16 sm:py-20',
    tinted && 'bg-slate-50 dark:bg-slate-900/40',
    className,
  ]}
>
  <div class="mx-auto max-w-3xl">
    <h2
      class="mb-10 text-sm font-bold uppercase tracking-[0.2em] text-accent-600 dark:text-accent-400"
    >
      {title}
    </h2>
    <slot />
  </div>
</section>
