---
import { profile } from '../data/profile';
import Section from './Section.astro';

const { volunteering, languages, interests } = profile.extras;
---

<Section id="education" title="Education">
  <div class="space-y-8">
    {
      profile.education.map((entry) => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">
              {entry.degree} · {entry.field}
            </h3>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-500">
              {entry.period}
            </span>
          </div>
          <p class="mt-0.5 text-sm">
            <span class="font-semibold text-accent-600 dark:text-accent-400">
              {entry.institution}
            </span>
            <span class="text-slate-400 dark:text-slate-600"> · </span>
            <span class="text-slate-500 dark:text-slate-500">{entry.location}</span>
          </p>

          {entry.notes && (
            <ul class="mt-3 space-y-2 text-sm leading-relaxed">
              {entry.notes.map((note) => (
                <li class="flex gap-2.5">
                  <span class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-slate-400 dark:bg-slate-600" aria-hidden="true" />
                  <span>{note}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>

  <!-- Smaller CV details, grouped so they don't each need their own section. -->
  <div
    class="mt-12 grid gap-8 border-t border-slate-200 pt-8 sm:grid-cols-3 dark:border-slate-800"
  >
    <div>
      <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-500">
        Volunteering
      </h3>
      {
        volunteering.map((item) => (
          <p class="text-sm">
            <span class="font-semibold text-slate-900 dark:text-white">{item.role}</span>
            <br />
            <span class="text-slate-500 dark:text-slate-500">
              {item.organisation}, {item.period}
            </span>
          </p>
        ))
      }
    </div>

    <div>
      <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-500">
        Languages
      </h3>
      <ul class="space-y-1 text-sm">
        {
          languages.map((language) => (
            <li>
              <span class="font-semibold text-slate-900 dark:text-white">{language.name}</span>
              <span class="text-slate-500 dark:text-slate-500"> — {language.level}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-500">
        Interests
      </h3>
      <ul class="flex flex-wrap gap-1.5">
        {
          interests.map((interest) => (
            <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
              {interest}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
