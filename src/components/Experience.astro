---
import { profile } from '../data/profile';
import Section from './Section.astro';
import Icon from './Icon.astro';
---

<Section id="experience" title="Experience" tinted>
  <!-- Timeline: the left border is the spine, each role hangs a dot off it. -->
  <ol class="relative space-y-10 border-l border-slate-200 pl-6 dark:border-slate-800">
    {
      profile.experience.map((job) => (
        <li class="relative">
          <span
            class="absolute -left-[1.9rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-accent-500 dark:border-slate-900"
            aria-hidden="true"
          />

          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">
              {job.role}
            </h3>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-500">
              {job.period}
            </span>
          </div>

          <p class="mt-0.5 flex flex-wrap items-center gap-x-2 text-sm">
            {job.url ? (
              <a
                href={job.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-accent-600 hover:underline dark:text-accent-400"
              >
                {job.company}
                <Icon name="external" class="h-3 w-3" />
              </a>
            ) : (
              <span class="font-semibold text-accent-600 dark:text-accent-400">
                {job.company}
              </span>
            )}
            <span class="text-slate-400 dark:text-slate-600">·</span>
            <span class="text-slate-500 dark:text-slate-500">{job.location}</span>
          </p>

          <ul class="mt-3 space-y-2 text-sm leading-relaxed sm:text-base">
            {job.bullets.map((bullet) => (
              <li class="flex gap-2.5">
                <span class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-slate-400 dark:bg-slate-600" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
