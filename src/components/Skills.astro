---
import { profile } from '../data/profile';
import Section from './Section.astro';
---

<Section id="skills" title="Skills" tinted>
  <div class="space-y-6">
    {
      profile.skills.map((group) => (
        <div class="grid gap-2 sm:grid-cols-[10rem_1fr] sm:gap-4">
          <h3 class="pt-0.5 text-sm font-bold text-slate-900 dark:text-white">
            {group.group}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-md border border-slate-200 bg-white px-2.5 py-1 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
